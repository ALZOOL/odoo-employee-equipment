<odoo>
    <data>
        <record model="ir.ui.view" id="equipment_view_list">
            <field name="name">device.equipment.view.list</field>
            <field name="model">device.equipment</field>
            <field name="arch" type="xml">
                <list multi_edit="1" class="header_custom">
                    <field name="name" />
                    <field name="serial_number" />
                    <field name="purchase_date" />
                    <field name="price" />
                    <field name="active" />
                    <field name="status" />
                    <field name="employee_id" invisible="status != 'assigned'" />

                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="equipment_view_form">
            <field name="name">device.equipment.view.form</field>
            <field name="model">device.equipment</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" />
                            <h1>
                                <field name="name" placeholder="Device Name" />
                            </h1>
                        </div>

                        <group string="General Information">
                            <field name="serial_number" />
                            <field name="purchase_date" />
                            <field name="price" />
                            <field name="active" />
                            <field name="status" />
                            <field name="employee_id" invisible="status != 'assigned'" />
                            <button name="action_status_assigend" type="object"
                                string="Make Assigned" />
                            <button name="action_status_available" type="object"
                                string="Make Available" />
                            <button name="action_return" type="object" string="Return" />
                        </group>
                    </sheet>

                </form>

            </field>
        </record>

        <record model="ir.ui.view" id="equipment_view_search">
            <field name="name">device.equipment.search</field>
            <field name="model">device.equipment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="serial_number" />
                    <field name="name" />
                </search>
            </field>
        </record>

        <record id="device_equipment_search" model="ir.ui.view">
            <field name="name">device.equipment.search</field>
            <field name="model">device.equipment</field>

            <field name="arch" type="xml">
                <search>

                    <!-- Search -->
                    <field name="name" />
                    <field name="serial_number" />
                    <field name="employee_id" />

                    <!-- Filters -->
                    <filter
                        name="available"
                        string="Available"
                        domain="[('status', '=', 'available')]"
                    />

                    <filter
                        name="Assigned"
                        string="Assigned"
                        domain="[('status', '=', 'assigned')]"
                    />

                    <separator />

                    <!-- Group By -->
                    <group expand="0" string="Group By">

                        <filter
                            name="group_by_status"
                            string="Status"
                            context="{'group_by': 'status'}"
                        />

                        <filter
                            name="group_by_employee"
                            string="Employee"
                            context="{'group_by': 'employee_id'}"
                        />

                    </group>

                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="equipment_action">
            <field name="name">device.equipment.action</field>
            <field name="res_model">device.equipment</field>
            <field name="view_mode">list,form</field>
        </record>


    </data>
</odoo>